{
  "name": "dynamic-learner",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "webpack serve --config webpack.config.mts --disable-interpret --mode development",
    "build": "npm run typecheck && webpack --config webpack.config.mts --disable-interpret --mode production",
    "pages:prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test:answer-matching": "node --test packages/@dynamic-learner/answer-matching/tests/*.test.mts"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "copy-webpack-plugin": "13.0.1",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "7.0.4",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6"
  },
  "engines": {
    "node": ">=24"
  }
}
